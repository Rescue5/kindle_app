# Copy this file to .env when you want DS Lab / DeepSeek enrichment.
# The desktop app and local deterministic optimizer work without these values.

# Required only for LLM enrichment.
DSLAB_API_KEY=

# Defaults used by kindle_vocab_app.llm_enricher.py.
DSLAB_BASE_URL=https://api.dslab.tech/v1
DSLAB_MODEL=deepseek-v4-flash

# Optional tuning.
# DSLAB_REASONING_EFFORT=low
# DSLAB_TIMEOUT_SECONDS=90

# Optional app diagnostics.
# KINDLE_VOCAB_LOG_LEVEL=DEBUG
